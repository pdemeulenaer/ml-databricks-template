# The catalog and schema resources are target-scoped. Existing resources are referenced
# by name without taking ownership; managed ones are created on deployment.
{% if dev_catalog_action == 'create' or dev_schemas_action == 'create' or qa_catalog_action == 'create' or qa_schemas_action == 'create' or prod_catalog_action == 'create' or prod_schemas_action == 'create' %}
targets:
{% for environment in ['dev', 'qa', 'prod'] %}
{% set catalog_action = _copier_answers[environment ~ '_catalog_action'] %}
{% set schemas_action = 'create' if catalog_action == 'create' else _copier_answers.get(environment ~ '_schemas_action', 'use_existing') %}
{% set storage_root = _copier_answers.get(environment ~ '_catalog_storage_root', '') %}
{% if catalog_action == 'create' or schemas_action == 'create' %}
  {{ environment }}:
    resources:
{% if catalog_action == 'create' and storage_root %}
      catalogs:
        environment_catalog:
          name: ${var.catalog}
          lifecycle: {prevent_destroy: true}
{% if storage_root %}
          storage_root: {{ storage_root | to_json }}
{% endif %}
{% endif %}
{% if catalog_action == 'create' and not storage_root %}
      jobs:
        provision_catalog:
          name: ${bundle.name}-provision-catalog
          performance_target: STANDARD
          tasks:
            - task_key: create_catalog
              notebook_task:
                notebook_path: ../src/provision_catalog.py
                base_parameters:
                  catalog: ${var.catalog}
      job_runs:
        provision_catalog_run:
          job_id: ${resources.jobs.provision_catalog.id}
          lifecycle:
            triggers:
              - on_bundle_deploy: true
{% endif %}
{% if schemas_action == 'create' %}
      schemas:
{% for schema in ['lz', 'bronze', 'silver', 'gold'] %}
        {{ schema }}:
          name: {{ schema }}
{% if catalog_action == 'create' and storage_root %}
          catalog_name: ${resources.catalogs.environment_catalog.name}
{% else %}
          catalog_name: ${var.catalog}
{% endif %}
{% if catalog_action == 'create' and not storage_root %}
          # This reference makes creation wait for the provisioning job to succeed.
          comment: "Catalog provisioning run: ${resources.job_runs.provision_catalog_run.state.result_state}"
{% endif %}
          lifecycle: {prevent_destroy: true}
{% endfor %}
      volumes:
        landing_files:
          name: {{ package_name }}_files
          catalog_name: ${var.catalog}
          schema_name: ${resources.schemas.lz.name}
          volume_type: MANAGED
          lifecycle: {prevent_destroy: true}
      pipelines:
        features:
          schema: ${resources.schemas.gold.name}
          configuration:
            project.bronze_schema: ${resources.schemas.bronze.name}
            project.silver_schema: ${resources.schemas.silver.name}
{% endif %}
{% endif %}
{% endfor %}
{% else %}
{}
{% endif %}
