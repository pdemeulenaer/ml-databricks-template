"""Model contract for the reference example."""

from dataclasses import dataclass

PROBLEM = "{{ problem_type }}"
{% if problem_type == "forecasting" %}
FEATURES = ["lag_1", "lag_24", "hour_sin", "hour_cos"]
{% else %}
FEATURES = ["x1", "x2"]
{% endif %}
HORIZON = 3
LOOKBACK = 24


@dataclass(frozen=True)
class Settings:
    """Validate identifiers at the external configuration boundary."""

    catalog: str

    def __post_init__(self):
        import re

        if not re.fullmatch(r"[a-z][a-z0-9_]*", self.catalog):
            raise ValueError(f"Use a lowercase SQL identifier: {self.catalog!r}")

    def table(self, layer: str, name: str) -> str:
        schemas = {"gold": "gold", "predictions": "gold", "monitoring": "gold"}
        names = {
            "features": "features",
            "batch": "batch_predictions",
            "metrics": "monitoring_metrics",
        }
        return f"{self.catalog}.{schemas[layer]}.{{ package_name }}_{names[name]}"

    @property
    def model_name(self) -> str:
        return f"{self.catalog}.gold.{{ package_name }}_model"
