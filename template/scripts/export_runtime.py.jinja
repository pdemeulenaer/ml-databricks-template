"""Export locked runtime dependencies into bundle job/pipeline environments."""

import json
import subprocess
from pathlib import Path


def main():
    exported = subprocess.run(
        ["uv", "export", "--frozen", "--no-dev", "--no-emit-project", "--no-hashes"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    dependencies = [
        line for line in exported.splitlines() if line.strip() and not line.startswith("#")
    ]
    # JSON is valid YAML. Generated overlays are excluded from version control.
    resources = {
        "jobs": {
            key: {
                "environments": [
                    {
                        "environment_key": "runtime",
                        "spec": {"dependencies": ["../dist/*.whl", *dependencies]},
                    }
                ]
            }
            for key in ("training", "inference", "monitoring", "smoke")
        }
    }
    resources["pipelines"] = {
        "features": {"environment": {"dependencies": ["../dist/*.whl", *dependencies]}}
    }
    Path("resources/runtime.generated.yml").write_text(
        json.dumps({"resources": resources}, indent=2)
    )
    dev = {
        "targets": {
            "dev": {
                "resources": {
                    "jobs": {
                        "seed_dev": {
                            "environments": [
                                {
                                    "environment_key": "runtime",
                                    "spec": {"dependencies": ["../dist/*.whl", *dependencies]},
                                }
                            ]
                        }
                    }
                }
            }
        }
    }
    Path("resources/dev-runtime.generated.yml").write_text(json.dumps(dev, indent=2))


if __name__ == "__main__":
    main()
