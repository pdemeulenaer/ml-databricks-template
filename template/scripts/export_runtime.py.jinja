"""Export locked runtime dependencies without redefining bundle resources."""

import json
import subprocess
from pathlib import Path


def main():
    exported = subprocess.run(
        ["uv", "export", "--frozen", "--no-dev", "--no-emit-project", "--no-hashes"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    dependencies = [
        line for line in exported.splitlines() if line.strip() and not line.startswith("#")
    ]
    # All resources live under resources/, so the wheel is relative to that directory.
    runtime_dependencies = ["../dist/*.whl", *dependencies]
    targets = {
        target: {"variables": {"runtime_dependencies": runtime_dependencies}}
        for target in ("dev", "qa", "prod")
    }
    # JSON is valid YAML. Target variables augment config without redefining resources.
    Path("resources/runtime.generated.yml").write_text(json.dumps({"targets": targets}, indent=2))
    # Replace the legacy DEV resource overlay left by v0.2.0 on existing projects.
    legacy = Path("resources/dev-runtime.generated.yml")
    if legacy.exists():
        legacy.write_text("{}\n")


if __name__ == "__main__":
    main()
