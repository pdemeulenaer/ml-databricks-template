"""Lakeflow definitions: managed writes, explicit multi-schema publishing."""

from pyspark import pipelines as dp
from pyspark.sql import SparkSession, Window
from pyspark.sql import functions as F

from {{ package_name }}.config import FEATURES, HORIZON, PROBLEM

spark = SparkSession.builder.getOrCreate()
catalog = spark.conf.get("project.catalog")
landing = f"/Volumes/{catalog}/lz/{{ package_name }}_files/input"
ingestion_mode = "{{ ingestion_mode }}"
raw_schema = "id string, series_id string, event_time timestamp, target double" + (
    ", x1 double, x2 double" if PROBLEM != "forecasting" else ""
)


def raw_input():
    reader = spark.readStream.format("cloudFiles").option("cloudFiles.format", "json")
    if ingestion_mode == "batch":
        return spark.read.schema(raw_schema).json(landing)
    return reader.schema(raw_schema).load(landing)


if ingestion_mode == "batch":

    @dp.materialized_view(name=f"{catalog}.bronze.{{ package_name }}_raw")
    def bronze():
        return raw_input()
else:

    @dp.table(name=f"{catalog}.bronze.{{ package_name }}_raw")
    def bronze():
        return raw_input()


@dp.materialized_view(name=f"{catalog}.silver.{{ package_name }}_curated")
@dp.expect_or_fail("required_id", "id IS NOT NULL")
@dp.expect_or_drop("valid_time", "event_time IS NOT NULL AND series_id IS NOT NULL")
@dp.expect("label_available", "target IS NOT NULL")
def silver():
    frame = spark.read.table(f"{catalog}.bronze.{{ package_name }}_raw")
    numeric = ["target"] if PROBLEM == "forecasting" else FEATURES
    for name in numeric:
        frame = frame.where(
            F.col(name).isNotNull() & ~F.isnan(name) & (F.abs(F.col(name)) != float("inf"))
        )
    return frame


@dp.materialized_view(name=f"{catalog}.gold.{{ package_name }}_features")
@dp.expect_or_fail("unique_key", "key_count = 1")
@dp.expect_or_fail("unique_series_time", "time_count = 1")
@dp.expect_or_fail(
    "regular_hourly", "previous_time IS NULL OR event_time = previous_time + INTERVAL 1 HOUR"
)
def gold():
    frame = spark.read.table(f"{catalog}.silver.{{ package_name }}_curated")
    frame = frame.withColumn("key_count", F.count("*").over(Window.partitionBy("id")))
    if PROBLEM != "forecasting":
        return (
            frame.withColumn("label_time", F.col("event_time"))
            .withColumn("time_count", F.lit(1))
            .withColumn("previous_time", F.lit(None).cast("timestamp"))
        )
    window = Window.partitionBy("series_id").orderBy("event_time")
    frame = (
        frame.withColumn(
            "time_count", F.count("*").over(Window.partitionBy("series_id", "event_time"))
        )
        .withColumn("previous_time", F.lag("event_time").over(window))
        .withColumn("lag_1", F.lag("target", 1).over(window))
        .withColumn("lag_24", F.lag("target", 24).over(window))
        .withColumn("future_target", F.lead("target", HORIZON).over(window))
        .withColumn("label_time", F.col("event_time") + F.expr(f"INTERVAL {HORIZON} HOURS"))
        .withColumn("hour_sin", F.sin(F.hour("label_time") * F.lit(2 * 3.141592653589793 / 24)))
        .withColumn("hour_cos", F.cos(F.hour("label_time") * F.lit(2 * 3.141592653589793 / 24)))
        .drop("target")
        .withColumnRenamed("future_target", "target")
    )
    return frame.dropna(subset=FEATURES)
