[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "Small, testable Databricks ML workflow"
requires-python = ">=3.12,<3.13"
dependencies = ["numpy>=2.1,<3", "pandas>=2.2,<3", "scikit-learn>=1.6,<2", "mlflow>=3.17.2,<4"]

[project.scripts]
ml-workflow = "{{ package_name }}.jobs.cli:main"

[dependency-groups]
dev = ["pytest>=8,<10", "jsonschema>=4.23,<5", "pyyaml>=6,<7", "ruff>=0.11,<1", "pre-commit>=4,<5", "bandit[toml]>=1.8,<2"]
docs = ["mkdocs>=1.6,<2", "mkdocs-material>=9.6,<10", "mkdocstrings[python]>=0.29,<1", "pymdown-extensions>=10.14,<11"]

[build-system]
requires = ["hatchling>=1.27,<2"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP"]

[tool.pytest.ini_options]
testpaths = ["tests/unit"]

[tool.bandit]
exclude_dirs = ["tests"]
